# Server
PORT=4000

# Sandbox (Docker) resource limits
MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
SANDBOX_MEMORY_MB=2048
SANDBOX_CPU_QUOTA=1.5
SANDBOX_TIMEOUT_SECONDS=600

# NOTE: GitHub token and Anthropic API key are NOT set here.
# They are supplied per-task from the frontend (see README "Security Model").
